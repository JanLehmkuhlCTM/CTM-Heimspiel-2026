{
  "folders": [
    {
      "path": "CTM Custom App"
    },
    {
      "path": ".AL-Go"
    }
  ],
  "settings": {
    "al.enableCodeActions": true,
    "al.enableCodeAnalysis": true,
    "al.codeAnalyzers": [
      "${CodeCop}",
      "${UICop}",
      "${PerTenantExtensionCop}"
    ],
    "CRS.ObjectNameSuffix": "",
    "CRS.FileNamePattern": "<ObjectNameShort>.<ObjectType>.al",
    "CRS.FileNamePatternExtensions": "<ObjectNameShort>.<ObjectTypeShortPascalCase>.al",
    "CRS.NamespacePrefixToIgnore": "CTM.Heimspiel",
    "CRS.ReorganizeByNamespace": true,
    "al.backgroundCodeAnalysis": "Project",
    "alOutline.completionProviders": [
      "VariableNamesWithType",
      "VariableNames"
    ]
  }
}
