{
  "useCompilerFolder": true,
  "doNotPublishApps": false,
  "doNotRunTests": false,
  "runs-on": "windows-latest",
  "githubRunner": "windows-latest",
  "workspaceCompilation": {
    "enabled": true,
    "parallelism": 0
  },
  "workflowConcurrency": [
    "group: ${{ github.workflow }}-${{ github.ref }}",
    "cancel-in-progress: true"
  ]
}
